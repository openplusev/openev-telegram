# Required, from @BotFather
TELEGRAM_BOT_TOKEN=
# Shared secret for /v1/internal/* (account linking, subscribers, deliveries), same value as the API's
INTERNAL_TOKEN=

# Optional
# REST and the live event WebSocket (/v1/ws); the container reaches the API on the proxy network
OPENEV_API_URL=http://openev-api:8080
OPENEV_WEBSITE_URL=https://openev.coding-global.com
LOG_LEVEL=info
# Chat settings, sent alert ids, paused and blocked users; a docker volume in production
DATA_DIR=/app/data
# 1 renders messages and fan out decisions to stdout instead of Telegram, writes nothing
DRY_RUN=
